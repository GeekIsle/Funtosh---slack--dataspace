        "custom_liquid": "<style>\n.eqp-h1{text-align:center;margin:0 0 8px;color:#3278b3}\n.eqp-lead{text-align:center;max-width:560px;margin:0 auto 18px;color:#5a5f73}\n.eqp{border:0;border-radius:10px;padding:18px 20px;background:linear-gradient(to right,#007ae7,#2ad265);color:#fff;margin:0 auto 6px;box-shadow:0 14px 30px -20px rgba(0,122,231,.7);scroll-margin-top:120px}\n.eqp a{color:#fff;text-decoration:underline}\n.eqp-row{display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;align-items:center}\n.eqp-big{font-size:2rem;font-weight:800;line-height:1}\n.eqp-small{font-size:.9rem;opacity:.95}\n.eqp-stats{display:flex;gap:18px;flex-wrap:wrap}\n.eqp-stat b{display:block;font-size:1.2rem}\n.eqp-bar{height:10px;background:rgba(255,255,255,.3);border-radius:999px;overflow:hidden;margin:12px 0 6px}\n.eqp-bar span{display:block;height:100%;background:#fff;border-radius:999px}\n.eqp-guest{text-align:center}\n.eqp-btns{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:12px}\n.eqp-btn{display:inline-block;background:#fff;color:#007ae7!important;text-decoration:none!important;border-radius:40px;padding:13px 36px;font-weight:600;font-size:15px}.eqp-btn:hover{color:#2ad265!important}\n.eqp-btn.alt{background:transparent;color:#fff!important;border:2px solid #fff}\n.eqh{background:#fff;border-radius:22px;padding:20px 22px;margin:14px auto 6px;box-shadow:0 18px 40px -28px rgba(60,120,221,.55);border:1px solid #e6eefc;color:#1d2433}\n.eqh-head{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin-bottom:10px}\n.eqh-title{font-weight:800;font-size:1.1rem;background:linear-gradient(90deg,#3C78DD,#29CE70);-webkit-background-clip:text;background-clip:text;color:transparent}\n.eqh-sub{font-size:.85rem;color:#7a8196}\n.eqh ul{list-style:none;margin:0;padding:0}\n.eqh li{display:flex;align-items:center;gap:12px;padding:11px 0;border-top:1px solid #eef2f8}\n.eqh li:first-child{border-top:0}\n.eqh-ico{flex:0 0 38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;background:#e9f9f0}\n.eqh-ico.t-Eco-Quest{background:#e6f0ff}.eqh-ico.t-Reward{background:#fff4e0}.eqh-ico.t-Refund{background:#f1f2f5}\n.eqh-txt{flex:1;min-width:0}\n.eqh-l{font-weight:600;font-size:.95rem;color:#1d2433;overflow-wrap:anywhere}\n.eqh-d{font-size:.8rem;color:#7a8196}\n.eqh-p{font-weight:800;white-space:nowrap;font-size:1rem}\n.eqh-p.pos{background:linear-gradient(90deg,#3C78DD,#29CE70);-webkit-background-clip:text;background-clip:text;color:transparent}\n.eqh-p.neg{color:#8a90a2}\n.eqh-empty{text-align:center;color:#7a8196;font-size:.92rem;padding:10px 0 4px}\n</style>\n<h1 class=\"eqp-h1\">Earn Eco Points. Unlock Rewards.</h1>\n<p class=\"eqp-lead\">Shop and play Eco-Quest to earn Eco Points, then redeem them for savings on your next order.</p>\n{%- if customer -%}\n  <script>window.mimroEqTags={{ customer.tags | json }};</script>\n  {%- assign eq_pts = customer.metafields.eco_quest.points.value | default: 0 -%}\n  {%- assign eq_life = customer.metafields.eco_quest.lifetime_points.value | default: 0 -%}\n  {%- assign eq_streak = customer.metafields.eco_quest.streak.value | default: 0 -%}\n  {%- assign eq_last = customer.metafields.eco_quest.last_week.value -%}\n  {%- assign eq_prog = eq_pts | modulo: 500 -%}\n  {%- assign eq_pct = eq_prog | times: 100 | divided_by: 500 -%}\n  {%- assign eq_need = 500 | minus: eq_prog -%}\n  <div class=\"eqp\" id=\"eco-points\">\n    <div class=\"eqp-row\">\n      <div>\n        <div class=\"eqp-small\">Hi {{ customer.first_name | default: 'there' }}, your Eco Points</div>\n        <div class=\"eqp-big\">{{ eq_pts }} pts</div>\n        <div class=\"eqp-small\">= {{ eq_pts | money }} toward your next code</div>\n      </div>\n      <div class=\"eqp-stats\">\n        <div class=\"eqp-stat\"><b>🔥 {{ eq_streak }}</b><span class=\"eqp-small\">week streak</span></div>\n        <div class=\"eqp-stat\"><b>{{ eq_life }}</b><span class=\"eqp-small\">lifetime pts</span></div>\n      </div>\n    </div>\n    <div class=\"eqp-bar\"><span style=\"width:{{ eq_pct }}%\"></span></div>\n    <div class=\"eqp-small\">{{ eq_need }} more points to your next $5 off code.{% if eq_last != blank %} Last credited: {{ eq_last }}.{% endif %} Points are added every Monday.</div>\n    <div class=\"eqp-btns\"><a class=\"eqp-btn\" href=\"#eco-quest\">Play Eco-Quest</a></div>\n  </div>\n  {%- assign eq_hist = customer.metafields.eco_quest.history.value -%}\n  <div class=\"eqh\" id=\"eco-history\">\n    <div class=\"eqh-head\"><div class=\"eqh-title\">Your Eco Points history</div><div class=\"eqh-sub\">Newest first</div></div>\n    {%- if eq_hist and eq_hist.size > 0 -%}\n    <ul>\n      {%- for h in eq_hist limit: 20 -%}\n      {%- case h.t -%}{%- when 'Eco-Quest' -%}{%- assign ic = '🌍' -%}{%- when 'Purchase' -%}{%- assign ic = '🛍️' -%}{%- when 'Bonus' -%}{%- assign ic = '🎁' -%}{%- when 'Reward' -%}{%- assign ic = '🏷️' -%}{%- when 'Refund' -%}{%- assign ic = '↩️' -%}{%- else -%}{%- assign ic = '🌱' -%}{%- endcase -%}\n      <li><span class=\"eqh-ico t-{{ h.t | escape }}\">{{ ic }}</span><span class=\"eqh-txt\"><span class=\"eqh-l\">{{ h.l | escape }}</span><br><span class=\"eqh-d\">{{ h.d | date: '%b %-d, %Y' }} · {{ h.t | escape }}</span></span><span class=\"eqh-p {% if h.p < 0 %}neg{% else %}pos{% endif %}\">{% if h.p >= 0 %}+{% endif %}{{ h.p }} pts</span></li>\n      {%- endfor -%}\n    </ul>\n    {%- else -%}\n    <div class=\"eqh-empty\">No points yet. Play this week's Eco-Quest or place an order to start earning 🌱</div>\n    {%- endif -%}\n  </div>\n{%- else -%}\n  <div class=\"eqp eqp-guest\" id=\"eco-points\">\n    <div style=\"font-weight:700;font-size:1.1rem\">Check your Eco Points balance &amp; streak</div>\n    <div class=\"eqp-small\">Sign in with the email you use to claim points.</div>\n    <div class=\"eqp-btns\"><a class=\"eqp-btn\" href=\"{{ routes.account_login_url }}?return_url={{ request.path | url_encode }}\">View My Points</a><a class=\"eqp-btn alt\" href=\"#eco-quest\">Play Eco-Quest</a></div>\n  </div>\n{%- endif -%}\n",
