    "home_categories": {
      "type": "custom-liquid",
      "settings": {
        "title": "",
        "description": "",
        "custom_liquid": "<style>\n.mh{--grad:linear-gradient(100deg,#007ae7 0%,#2ad265 100%);max-width:1320px;margin:0 auto;color:#020624}\n.mh-head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin:0 0 14px}\n.mh-head h2{margin:0;font-size:clamp(1.3rem,1rem + 1.2vw,1.9rem);font-weight:800;letter-spacing:-.02em;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent}\n.mh-head a{font-weight:700;font-size:.9rem;white-space:nowrap;text-decoration:none!important;background-image:none!important;color:#007ae7!important}\n.mh-row{display:grid;grid-template-columns:repeat(9,minmax(0,1fr));gap:12px}\n.mh a.mh-cat{display:flex!important;flex-direction:column;align-items:center;gap:8px;padding:10px 8px 12px;border:1.5px solid #e4ebf5!important;border-radius:16px;background:#fff!important;background-image:none!important;text-decoration:none!important;color:#020624!important;transition:transform .15s,box-shadow .15s,border-color .15s;text-align:center}\n.mh a.mh-cat:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(2,6,36,.08);border-color:#9cc7f2!important}\n.mh a.mh-cat::before,.mh a.mh-cat::after,.mh a.mh-brand::before,.mh a.mh-brand::after,.mh-head a::after,.mh-head a::before{display:none!important;content:none!important}\n.mh-cat .mh-img{width:100%;aspect-ratio:1;border-radius:12px;background:#f7f9fc;display:flex;align-items:center;justify-content:center;overflow:hidden}\n.mh-cat .mh-img img{width:86%;height:86%;object-fit:contain;mix-blend-mode:multiply}\n.mh-cat b{font-size:.82rem;line-height:1.2;font-weight:700}\n@media(max-width:1100px){.mh-row{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:minmax(118px,1fr);overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:6px}.mh-row>*{scroll-snap-align:start}}\n</style>\n<div class=\"mh\">\n<div class=\"mh-head\"><h2>Shop by Category</h2><a href=\"/pages/shop-by-category\">All categories &rarr;</a></div>\n<div class=\"mh-row\">\n{%- for l in linklists['categories'].links -%}\n{%- assign c = l.object -%}{%- assign img = c.image | default: c.products.first.featured_image -%}\n<a class=\"mh-cat\" href=\"{{ l.url }}\"><span class=\"mh-img\">{%- if img -%}<img src=\"{{ img | image_url: width: 260 }}\" alt=\"{{ l.title | escape }}\" loading=\"lazy\" width=\"260\" height=\"260\">{%- endif -%}</span><b>{{ l.title }}</b></a>\n{%- endfor -%}\n</div>\n</div>",
        "section_width": "full-width",
        "section_padding_top": 30,
        "section_padding_bottom": 5,
        "colors": "white"
      },
      "name": "Shop by Category (tiles)"
    },
    "home_ecoquest": {
      "type": "custom-liquid",
      "settings": {
        "title": "",
        "description": "",
        "custom_liquid": "<style>\n.mq{max-width:1320px;margin:0 auto}\n.mq-box{position:relative;overflow:hidden;display:grid;grid-template-columns:1.3fr 1fr;gap:24px;align-items:center;padding:clamp(22px,3vw,40px);border-radius:24px;background:linear-gradient(110deg,#0a5bd8 0%,#0f86d6 45%,#22c06a 100%);color:#fff}\n.mq-box:after{content:\"\";position:absolute;right:-60px;top:-60px;width:260px;height:260px;border-radius:50%;background:rgba(255,255,255,.08)}\n.mq-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:.78rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;background:rgba(255,255,255,.16);padding:6px 12px;border-radius:999px}\n.mq-dot{width:8px;height:8px;border-radius:50%;background:#7CFFB0;box-shadow:0 0 0 4px rgba(124,255,176,.25)}\n.mq h2{margin:12px 0 8px;font-size:clamp(1.5rem,1.1rem + 1.6vw,2.4rem);font-weight:800;line-height:1.12;letter-spacing:-.02em;color:#fff!important;-webkit-text-fill-color:#fff}\n.mq p{margin:0;opacity:.92;font-size:clamp(.95rem,.9rem + .2vw,1.08rem);max-width:560px}\n.mq-btns{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}\n.mq a.mq-btn{display:inline-flex!important;align-items:center;justify-content:center;padding:13px 24px;border-radius:999px;font-weight:800;font-size:14px;letter-spacing:.6px;text-transform:uppercase;text-decoration:none!important;background:#fff!important;background-image:none!important;color:#0a5bd8!important}\n.mq a.mq-btn.alt{background:transparent!important;color:#fff!important;border:2px solid rgba(255,255,255,.75)}\n.mq a.mq-btn::before,.mq a.mq-btn::after{display:none!important;content:none!important}\n.mq-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;position:relative;z-index:1}\n.mq-stat{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.22);border-radius:16px;padding:14px 10px;text-align:center}\n.mq-stat b{display:block;font-size:clamp(1.2rem,1rem + .8vw,1.7rem);font-weight:800}\n.mq-stat span{font-size:.78rem;opacity:.9}\n@media(max-width:800px){.mq-box{grid-template-columns:1fr}}\n</style>\n<div class=\"mq\"><div class=\"mq-box\">\n<div style=\"position:relative;z-index:1\">\n<span class=\"mq-eyebrow\"><span class=\"mq-dot\"></span>Weekly Eco-Quest · Live now</span>\n<h2>Play &amp; Earn. Unlock Eco Rewards.</h2>\n<p>Answer 3 quick eco questions, earn up to 400 Mimro Eco Points and turn every 500 points into $5 off. First time? Get +100 welcome points.</p>\n<div class=\"mq-btns\"><a class=\"mq-btn\" href=\"/pages/mimro-eco-rewards#eco-quest\">Play Eco-Quest</a><a class=\"mq-btn alt\" href=\"/pages/mimro-eco-rewards#eco-points\">{% if customer %}View my points{% else %}How it works{% endif %}</a></div>\n</div>\n<div class=\"mq-stats\"><div class=\"mq-stat\"><b>1 min</b><span>3 questions</span></div><div class=\"mq-stat\"><b>+400</b><span>points per quest</span></div><div class=\"mq-stat\"><b>$5</b><span>every 500 points</span></div></div>\n</div></div>",
        "section_width": "full-width",
        "section_padding_top": 30,
        "section_padding_bottom": 5,
        "colors": "white"
      },
      "name": "Eco-Quest CTA"
    },
    "home_brands": {
      "type": "custom-liquid",
      "settings": {
        "title": "",
        "description": "",
        "custom_liquid": "<style>\n.mb-row{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(120px,1fr);gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:6px}\n.mb-row>*{scroll-snap-align:start}\n.mh a.mh-brand{display:flex!important;flex-direction:column;align-items:center;gap:6px;padding:10px 8px 12px;border:1.5px solid #e4ebf5!important;border-radius:16px;background:#fff!important;background-image:none!important;text-decoration:none!important;color:#020624!important;text-align:center;transition:transform .15s,box-shadow .15s,border-color .15s}\n.mh a.mh-brand:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(2,6,36,.08);border-color:#9cc7f2!important}\n.mh-brand .mh-img{width:100%;aspect-ratio:1;border-radius:12px;background:#f7f9fc;display:flex;align-items:center;justify-content:center;overflow:hidden}\n.mh-brand .mh-img img{width:86%;height:86%;object-fit:contain;mix-blend-mode:multiply}\n.mh-brand b{font-size:.8rem;line-height:1.2;font-weight:700}\n</style>\n<div class=\"mh\">\n<div class=\"mh-head\"><h2>Shop by Brand</h2><a href=\"/pages/shop-by-brand\">All brands &rarr;</a></div>\n<div class=\"mb-row\">\n{%- for l in linklists['brands'].links -%}\n{%- assign c = l.object -%}{%- assign img = c.image | default: c.products.first.featured_image -%}\n<a class=\"mh-brand\" href=\"{{ l.url }}\"><span class=\"mh-img\">{%- if img -%}<img src=\"{{ img | image_url: width: 220 }}\" alt=\"{{ l.title | escape }}\" loading=\"lazy\" width=\"220\" height=\"220\">{%- endif -%}</span><b>{{ l.title }}</b></a>\n{%- endfor -%}\n</div>\n</div>",
        "section_width": "full-width",
        "section_padding_top": 30,
        "section_padding_bottom": 10,
        "colors": "white"
      },
      "name": "Shop by Brand (strip)"
    }
