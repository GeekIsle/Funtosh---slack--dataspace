{
  "sections": {
    "points": {
      "type": "custom-liquid",
      "settings": {
        "title": "",
        "description": "",
        "custom_liquid": "<style>\n.eqp-h1{text-align:center;margin:0 0 8px;color:#3278b3}\n.eqp-lead{text-align:center;max-width:560px;margin:0 auto 18px;color:#5a5f73}\n.eqp{border:0;border-radius:10px;padding:18px 20px;background:linear-gradient(to right,#007ae7,#2ad265);color:#fff;margin:0 auto 6px;box-shadow:0 14px 30px -20px rgba(0,122,231,.7);scroll-margin-top:120px}\n.eqp a{color:#fff;text-decoration:underline}\n.eqp-row{display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;align-items:center}\n.eqp-big{font-size:2rem;font-weight:800;line-height:1}\n.eqp-small{font-size:.9rem;opacity:.95}\n.eqp-stats{display:flex;gap:18px;flex-wrap:wrap}\n.eqp-stat b{display:block;font-size:1.2rem}\n.eqp-bar{height:10px;background:rgba(255,255,255,.3);border-radius:999px;overflow:hidden;margin:12px 0 6px}\n.eqp-bar span{display:block;height:100%;background:#fff;border-radius:999px}\n.eqp-guest{text-align:center}\n.eqp-btns{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:12px}\n.eqp-btn{display:inline-block;background:#fff;color:#007ae7!important;text-decoration:none!important;border-radius:40px;padding:13px 36px;font-weight:600;font-size:15px}.eqp-btn:hover{color:#2ad265!important}\n.eqp-btn.alt{background:transparent;color:#fff!important;border:2px solid #fff}\n.eqh{background:#fff;border-radius:22px;padding:20px 22px;margin:14px auto 6px;box-shadow:0 18px 40px -28px rgba(60,120,221,.55);border:1px solid #e6eefc;color:#1d2433}\n.eqh-head{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin-bottom:10px}\n.eqh-title{font-weight:800;font-size:1.1rem;background:linear-gradient(90deg,#3C78DD,#29CE70);-webkit-background-clip:text;background-clip:text;color:transparent}\n.eqh-sub{font-size:.85rem;color:#7a8196}\n.eqh ul{list-style:none;margin:0;padding:0}\n.eqh li{display:flex;align-items:center;gap:12px;padding:11px 0;border-top:1px solid #eef2f8}\n.eqh li:first-child{border-top:0}\n.eqh-ico{flex:0 0 38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;background:#e9f9f0}\n.eqh-ico.t-Eco-Quest{background:#e6f0ff}.eqh-ico.t-Reward{background:#fff4e0}.eqh-ico.t-Refund{background:#f1f2f5}\n.eqh-txt{flex:1;min-width:0}\n.eqh-l{font-weight:600;font-size:.95rem;color:#1d2433;overflow-wrap:anywhere}\n.eqh-d{font-size:.8rem;color:#7a8196}\n.eqh-p{font-weight:800;white-space:nowrap;font-size:1rem}\n.eqh-p.pos{background:linear-gradient(90deg,#3C78DD,#29CE70);-webkit-background-clip:text;background-clip:text;color:transparent}\n.eqh-p.neg{color:#8a90a2}\n.eqh li.eqh-pend .eqh-d{color:#1f8f4c;font-weight:600}\n.eqh-empty{text-align:center;color:#7a8196;font-size:.92rem;padding:10px 0 4px}\n.eqp-redeem{margin-top:16px;padding:16px 18px;border-radius:16px;background:#f3f9ff;border:1.5px solid #dbe9fb}\n.eqp-redeem-t{font-weight:800;margin-bottom:8px;color:#020624}\n.eqp-redeem-row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:8px}\n.eqp-redeem select{font:inherit;padding:12px 16px;border:1px solid #c9c8cc;border-radius:999px;background:#fff;min-width:200px}\n.eqp-redeem button.eqp-btn{border:0;cursor:pointer;font:inherit}\n.eqp-rd summary{cursor:pointer;font-weight:700;color:#007ae7;list-style:none}.eqp-rd summary::-webkit-details-marker{display:none}.eqp-rd summary:before{content:\"+ \";font-weight:800}.eqp-rd[open] summary:before{content:\"− \"}.eqp-rd summary span{font-weight:400;color:#7a8196}.eqp-rd[open] summary{margin-bottom:10px}\n.eqp-redeem-ok{font-weight:700;color:#1f8f4c;background:#ebfaf1;border-color:#c8eed6}\n.eqp-codes{margin-top:16px;padding:16px 18px;border-radius:16px;background:#fff;color:#020624;border:1.5px solid #dbe9fb}\n.eqp-codes-t{font-weight:800;margin-bottom:10px}\n.eqp-code{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;padding:10px 0;border-top:1px solid #eef2f8}\n.eqp-code:first-of-type{border-top:0}\n.eqp-code-c{font-family:ui-monospace,Menlo,Consolas,monospace;font-weight:800;font-size:1.05rem;letter-spacing:1px;background:#f3f9ff;border:1.5px dashed #9cc7f2;border-radius:10px;padding:6px 12px}\n.eqp-code-m{font-size:.85rem;color:#5a5f73}\n.eqp-code-a{display:flex;gap:8px;flex-wrap:wrap}\n.eqp-codes .eqp-btn{font:inherit;padding:9px 18px;font-size:14px;font-weight:700;background:linear-gradient(100deg,#007ae7,#2ad265);color:#fff!important;border:0;cursor:pointer}\n.eqp-codes .eqp-btn.alt{background:#fff;color:#007ae7!important;border:2px solid #007ae7}\n</style>\n<h1 class=\"eqp-h1\">Earn Mimro Eco Points. Unlock Eco Rewards.</h1>\n<p class=\"eqp-lead\">Shop and play Eco-Quest to earn Mimro Eco Points, then redeem them for savings on your next order.</p>\n{%- if customer -%}\n  <script>window.mimroEqTags={{ customer.tags | json }};</script>\n  {%- assign eq_pts = customer.metafields.eco_quest.points.value | default: 0 -%}\n  {%- assign eq_life = customer.metafields.eco_quest.lifetime_points.value | default: 0 -%}\n  {%- assign eq_streak = customer.metafields.eco_quest.streak.value | default: 0 -%}\n  {%- assign eq_last = customer.metafields.eco_quest.last_week.value -%}\n  {%- comment -%}Points from a just-played Eco-Quest show instantly, before the account is credited{%- endcomment -%}\n  {%- assign eq_pend = 0 -%}\n  {%- assign eq_tagstr = customer.tags | join: ',' | downcase | prepend: ',' | append: ',' -%}\n  {%- for t in customer.tags -%}{%- assign tl = t | downcase -%}{%- assign tp = tl | slice: 0, 3 -%}\n    {%- if tp == 'eq-' and tl contains '-s' -%}{%- assign tparts = tl | split: '-s' -%}{%- assign twk = tparts[0] -%}{%- assign tsc = tparts[1] | plus: 0 -%}\n      {%- assign tck = ',' | append: twk | append: '-credited,' -%}\n      {%- unless eq_tagstr contains tck -%}{%- assign tadd = tsc | times: 100 -%}{%- if tsc == 3 -%}{%- assign tadd = tadd | plus: 100 -%}{%- endif -%}{%- assign eq_pend = eq_pend | plus: tadd -%}{%- endunless -%}\n    {%- endif -%}\n  {%- endfor -%}\n  {%- if eq_pend > 0 and eq_life == 0 -%}{%- assign eq_pend = eq_pend | plus: 100 -%}{%- endif -%}\n  {%- assign eq_life0 = eq_life -%}\n  {%- assign eq_pts = eq_pts | plus: eq_pend -%}{%- assign eq_life = eq_life | plus: eq_pend -%}\n  {%- assign eq_prog = eq_pts | modulo: 500 -%}\n  {%- assign eq_pct = eq_prog | times: 100 | divided_by: 500 -%}\n  {%- assign eq_need = 500 | minus: eq_prog -%}\n  <div class=\"eqp\" id=\"eco-points\">\n    <div class=\"eqp-row\">\n      <div>\n        <div class=\"eqp-small\">Hi {{ customer.first_name | default: 'there' }}, your Mimro Eco Points</div>\n        <div class=\"eqp-big\">{{ eq_pts }} pts</div>\n        <div class=\"eqp-small\">= {{ eq_pts | money }} toward your next code</div>\n      </div>\n      <div class=\"eqp-stats\">\n        <div class=\"eqp-stat\"><b>🔥 {{ eq_streak }}</b><span class=\"eqp-small\">week streak</span></div>\n        <div class=\"eqp-stat\"><b>{{ eq_life }}</b><span class=\"eqp-small\">lifetime pts</span></div>\n      </div>\n    </div>\n    <div class=\"eqp-bar\"><span style=\"width:{{ eq_pct }}%\"></span></div>\n    {%- if eq_pend > 0 -%}<div class=\"eqp-small\">✓ Includes {{ eq_pend }} pts from your latest Eco-Quest. They're being added to your account now.</div>{%- endif -%}\n    {%- assign eq_max = eq_pts | divided_by: 500 -%}\n    {%- assign eq_req = false -%}{%- for t in customer.tags -%}{%- if t == 'eco-redeem' -%}{%- assign eq_req = true -%}{%- endif -%}{%- endfor -%}\n    <div class=\"eqp-small\">{% if eq_max > 0 %}You can redeem up to <b>${{ eq_max | times: 5 }} off</b> now, or keep saving.{% else %}{{ eq_need }} more points until you can redeem $5 off.{% endif %}{% if eq_last != blank %} Last credited: {{ eq_last }}.{% endif %}</div>\n    <div class=\"eqp-btns\"><a class=\"eqp-btn\" href=\"#eco-quest\">Play Eco-Quest</a><a class=\"eqp-btn alt\" href=\"#eco-history\">View points history</a></div>\n    {%- if eq_req -%}\n    <div class=\"eqp-redeem eqp-redeem-ok\">✓ Redemption requested. Your code will appear here on your points card within the hour, and the points will be deducted from your balance.</div>\n    {%- elsif eq_max > 0 -%}\n    <details class=\"eqp-redeem eqp-rd\" id=\"eqp-redeem\"><summary>Redeem points for a discount code <span>(optional)</span></summary>\n    <form method=\"post\" action=\"/contact#eco-points\" accept-charset=\"UTF-8\">\n      <input type=\"hidden\" name=\"form_type\" value=\"customer\">\n      <input type=\"hidden\" name=\"utf8\" value=\"✓\">\n      <input type=\"hidden\" name=\"return_to\" value=\"{{ request.path }}?redeem=sent#eco-points\">\n      <input type=\"hidden\" name=\"contact[email]\" value=\"{{ customer.email | escape }}\">\n      <input type=\"hidden\" name=\"contact[tags]\" id=\"eqp-redeem-tags\" value=\"eco-redeem,eco-redeem-5\">\n      <div class=\"eqp-redeem-row\">\n        <select id=\"eqp-redeem-amt\" aria-label=\"Redeem amount\">\n          {%- for n in (1..eq_max) limit: 10 -%}<option value=\"{{ n | times: 5 }}\">${{ n | times: 5 }} off · {{ n | times: 500 }} pts</option>{%- endfor -%}\n        </select>\n        <button type=\"submit\" class=\"eqp-btn\">Get my code</button>\n      </div>\n      <div class=\"eqp-small\">Prefer to keep saving? Just leave your points: they never convert on their own. Your code appears right here on your points card, single-use and valid for 12 months.</div>\n    </form>\n    </details>\n    <script>(function(){var s=document.getElementById('eqp-redeem-amt'),t=document.getElementById('eqp-redeem-tags');if(s&&t){var f=function(){t.value='eco-redeem,eco-redeem-'+s.value};s.addEventListener('change',f);f()}if(/redeem=sent/.test(location.search)){var r=document.getElementById('eqp-redeem');if(r)r.outerHTML='<div class=\"eqp-redeem eqp-redeem-ok\">✓ Redemption requested. Your code will appear here on your points card within the hour, and the points will be deducted from your balance.</div>'}})();</script>\n    {%- endif -%}\n    {%- assign eq_codes = customer.metafields.eco_quest.codes.value -%}\n    {%- if eq_codes and eq_codes.size > 0 -%}\n    <div class=\"eqp-codes\" id=\"eco-codes\">\n      <div class=\"eqp-codes-t\">🏷️ Your Mimro Eco Rewards codes</div>\n      {%- for c in eq_codes limit: 10 -%}\n      <div class=\"eqp-code\">\n        <div><span class=\"eqp-code-c\">{{ c.c | escape }}</span><div class=\"eqp-code-m\">${{ c.v }} off · issued {{ c.d | date: '%b %-d, %Y' }} · valid until {{ c.x | date: '%b %-d, %Y' }} · single use</div></div>\n        <div class=\"eqp-code-a\"><button type=\"button\" class=\"eqp-btn alt\" onclick=\"navigator.clipboard&&navigator.clipboard.writeText('{{ c.c | escape }}');this.textContent='Copied ✓'\">Copy</button><a class=\"eqp-btn\" href=\"/discount/{{ c.c | url_encode }}?redirect=/collections/all\">Apply &amp; shop</a></div>\n      </div>\n      {%- endfor -%}\n    </div>\n    {%- endif -%}\n  </div>\n  {%- assign eq_hist = customer.metafields.eco_quest.history.value -%}\n  <div class=\"eqh\" id=\"eco-history\">\n    <div class=\"eqh-head\"><div class=\"eqh-title\">Your Mimro Eco Points history</div><div class=\"eqh-sub\">Newest first</div></div>\n    {%- if eq_pend > 0 or eq_hist and eq_hist.size > 0 -%}\n    <ul>\n      {%- for t in customer.tags -%}{%- assign tl = t | downcase -%}{%- assign tp = tl | slice: 0, 3 -%}\n        {%- if tp == 'eq-' and tl contains '-s' -%}{%- assign tparts = tl | split: '-s' -%}{%- assign twk = tparts[0] -%}{%- assign tsc = tparts[1] | plus: 0 -%}\n          {%- assign tck = ',' | append: twk | append: '-credited,' -%}\n          {%- unless eq_tagstr contains tck -%}{%- assign tadd = tsc | times: 100 -%}{%- if tsc == 3 -%}{%- assign tadd = tadd | plus: 100 -%}{%- endif -%}\n          {%- assign twn = twk | split: 'w' | last | plus: 0 | minus: 1 | times: 604800 | plus: 1791806400 -%}\n      <li class=\"eqh-pend\"><span class=\"eqh-ico t-Eco-Quest\">🌍</span><span class=\"eqh-txt\"><span class=\"eqh-l\">Eco-Quest {{ twn | date: '%b %-d, %Y' }} · {{ tsc }} of 3 correct{% if tsc == 3 %} (perfect score){% endif %}</span><br><span class=\"eqh-d\">Being added to your account now · Eco-Quest</span></span><span class=\"eqh-p pos\">+{{ tadd }} pts</span></li>\n          {%- endunless -%}\n        {%- endif -%}\n      {%- endfor -%}\n      {%- if eq_pend > 0 and eq_life0 == 0 -%}\n      <li class=\"eqh-pend\"><span class=\"eqh-ico t-Bonus\">🎁</span><span class=\"eqh-txt\"><span class=\"eqh-l\">Welcome bonus</span><br><span class=\"eqh-d\">Being added to your account now · Bonus</span></span><span class=\"eqh-p pos\">+100 pts</span></li>\n      {%- endif -%}\n      {%- for h in eq_hist limit: 20 -%}\n      {%- case h.t -%}{%- when 'Eco-Quest' -%}{%- assign ic = '🌍' -%}{%- when 'Purchase' -%}{%- assign ic = '🛍️' -%}{%- when 'Bonus' -%}{%- assign ic = '🎁' -%}{%- when 'Reward' -%}{%- assign ic = '🏷️' -%}{%- when 'Refund' -%}{%- assign ic = '↩️' -%}{%- else -%}{%- assign ic = '🌱' -%}{%- endcase -%}\n      <li><span class=\"eqh-ico t-{{ h.t | escape }}\">{{ ic }}</span><span class=\"eqh-txt\"><span class=\"eqh-l\">{{ h.l | escape }}</span><br><span class=\"eqh-d\">{{ h.d | date: '%b %-d, %Y' }} · {{ h.t | escape }}</span></span><span class=\"eqh-p {% if h.p < 0 %}neg{% else %}pos{% endif %}\">{% if h.p >= 0 %}+{% endif %}{{ h.p }} pts</span></li>\n      {%- endfor -%}\n    </ul>\n    {%- else -%}\n    <div class=\"eqh-empty\">No points yet. Play this week's Eco-Quest or place an order to start earning 🌱</div>\n    {%- endif -%}\n  </div>\n{%- else -%}\n  <div class=\"eqp eqp-guest\" id=\"eco-points\">\n    <div style=\"font-weight:700;font-size:1.1rem\">Check your Mimro Eco Points balance &amp; streak</div>\n    <div class=\"eqp-small\">Sign in with the email you use to claim points.</div>\n    <div class=\"eqp-btns\"><a class=\"eqp-btn\" href=\"{{ routes.account_login_url }}?return_url={{ request.path | url_encode }}\">View My Points</a><a class=\"eqp-btn alt\" href=\"#eco-quest\">Play Eco-Quest</a></div>\n  </div>\n{%- endif -%}\n",
        "section_width": "narrow",
        "section_padding_top": 30,
        "section_padding_bottom": 0,
        "colors": "white"
      }
    },
    "main": {
      "type": "template--page",
      "settings": {
        "page_title_enabled": false,
        "page_width": "narrow"
      }
    }
  },
  "order": [
    "points",
    "main"
  ]
