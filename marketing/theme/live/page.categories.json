{
  "sections": {
    "categories": {
      "type": "custom-liquid",
      "settings": {
        "title": "",
        "description": "",
        "custom_liquid": "<style>\n.sbb{--grad:linear-gradient(100deg,#3C78DD,#29CE70);max-width:1200px;margin:0 auto;color:#020624}\n.sbb-hero{text-align:center;padding:8px 0 20px}\n.sbb-hero h2{margin:0 0 8px;font-size:clamp(1.6rem,4vw,2.3rem)}\n.sbb-hero p{margin:0 auto;max-width:640px;color:#5a5f73}\n.sbb-feat{display:flex;flex-wrap:wrap;align-items:center;gap:18px;justify-content:space-between;background:#f3f9ff;border:1.5px solid #dbe9fb;border-radius:20px;padding:18px 22px;margin:8px 0 22px;text-decoration:none!important;color:inherit!important}\n.sbb-feat img{width:96px;height:96px;object-fit:contain;border-radius:14px;background:#fff}\n.sbb-feat b{font-size:1.15rem}\n.sbb-feat .sbb-pill{background-image:var(--grad)!important;color:#fff!important;border-radius:999px;padding:11px 22px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;font-size:14px}\n.sbb-search{display:block;width:100%;max-width:420px;margin:0 auto 22px;padding:13px 20px;border:1.5px solid #c9d6e8;border-radius:999px;font:inherit}\n.sbb-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:16px}\n.sbb-tile{display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;padding:14px 12px 16px;border:1.5px solid #e4ebf5;border-radius:18px;background:#fff;text-decoration:none!important;color:#020624!important;transition:transform .15s,box-shadow .15s,border-color .15s}\n.sbb-tile:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(2,6,36,.08);border-color:#9cc7f2}\n.sbb-img{width:100%;aspect-ratio:1;display:flex;align-items:center;justify-content:center;background:#f7f9fc;border-radius:12px;overflow:hidden}\n.sbb-img img{width:100%;height:100%;object-fit:contain}\n.sbb-name{font-weight:800;font-size:1rem;line-height:1.25}\n.sbb-cta{font-size:.85rem;font-weight:700;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}\n.sbb-none{display:none;text-align:center;color:#7a8196;padding:20px}\n@media(max-width:480px){.sbb-grid{grid-template-columns:repeat(2,1fr);gap:12px}}\n.sbb a.sbb-tile,.sbb a.sbb-feat{background-image:none!important;text-decoration:none!important;box-shadow:none}\n.sbb a.sbb-tile::before,.sbb a.sbb-tile::after,.sbb a.sbb-feat::before,.sbb a.sbb-feat::after{display:none!important;content:none!important}\n.sbb a.sbb-tile{display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:flex-start;background:#fff!important;border:1.5px solid #e4ebf5!important;height:100%;box-sizing:border-box}\n.sbb a.sbb-tile:hover{border-color:#9cc7f2!important;box-shadow:0 10px 24px rgba(2,6,36,.08)}\n.sbb a.sbb-tile>span{display:block!important;width:100%}\n.sbb .sbb-img{display:flex!important}\n.sbb .sbb-name{margin-top:6px}\n.sbb a.sbb-feat{display:flex!important;flex-wrap:wrap!important;flex-direction:row!important;align-items:center!important;background:#f3f9ff!important;border:1.5px solid #dbe9fb!important;box-sizing:border-box;width:100%}\n.sbb a.sbb-feat img{flex:0 0 96px;display:block}\n.sbb a.sbb-feat .sbb-pill{display:inline-block!important;flex:0 0 auto;background-image:linear-gradient(100deg,#3C78DD,#29CE70)!important}\n.sbb input.sbb-search{display:block!important;box-sizing:border-box;width:100%!important;max-width:420px!important;margin:0 auto 22px!important;padding:13px 20px!important;border:1.5px solid #c9d6e8!important;border-radius:999px!important;background:#fff!important;height:auto!important}\n.sbb-grid{align-items:stretch}\n.sbb .sbc-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important;max-width:980px;margin:0 auto;gap:20px}\n@media(max-width:749px){.sbb .sbc-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:12px}}\n.sbb .sbc-count{font-size:.85rem;color:#7a8196}\n</style>\n<div class=\"sbb\">\n<div class=\"sbb-hero\"><h1 style=\"margin:0 0 8px;font-size:clamp(1.6rem,4vw,2.3rem)\">{{ page.title }}</h1><p>Find plastic-free, low-waste swaps for every part of your day, from the kitchen and bathroom to self-care and celebrations.</p></div>\n<div class=\"sbb-grid sbc-grid\">\n{%- for l in linklists['categories'].links -%}\n{%- assign c = l.object -%}\n{%- assign img = nil -%}{%- if c.image -%}{%- assign img = c.image -%}{%- elsif c.products.first.featured_image -%}{%- assign img = c.products.first.featured_image -%}{%- endif -%}\n<a class=\"sbb-tile\" href=\"{{ l.url }}\" data-n=\"{{ l.title | downcase | escape }}\"><span class=\"sbb-img\">{%- if img -%}<img src=\"{{ img | image_url: width: 500 }}\" alt=\"{{ l.title | escape }} at Mimro\" loading=\"lazy\" width=\"500\" height=\"500\">{%- endif -%}</span><span class=\"sbb-name\">{{ l.title }}</span>{%- if c.products_count -%}<span class=\"sbc-count\">{{ c.products_count }} products</span>{%- endif -%}<span class=\"sbb-cta\">Shop {{ l.title }} &rarr;</span></a>\n{%- endfor -%}\n</div>\n<p style=\"text-align:center;margin:26px 0 0\"><a href=\"/pages/shop-by-brand\" style=\"font-weight:700\">Prefer to shop by brand? See all our brands &rarr;</a></p>\n</div>",
        "section_width": "content",
        "section_padding_top": 30,
        "section_padding_bottom": 50,
        "colors": "white"
      }
    }
  },
  "order": [
    "categories"
  ]
}